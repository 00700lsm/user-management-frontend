{
  "name": "user-management-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contract:sync": "bash scripts/sync-contract.sh",
    "contract:generate": "npm run contract:sync && openapi-typescript .contract-cache/openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "contract:check": "npm run contract:generate && test -s src/shared/api/generated/schema.d.ts",
    "mocks:init": "msw init public --save",
    "prebuild": "npm run contract:generate"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "@tanstack/react-query": "^5.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.10.1",
    "msw": "^2.12.0",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
